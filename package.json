{
  "name": "@canopycanopycanopy/b-ber",
  "version": "0.1.7",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
    "npm": ">= 10.x"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "watch": "lerna run watch --stream",
    "build": "lerna run build",
    "bootstrap": "npm install",
    "bootstrap:clean": "lerna clean --yes && npm install && npm run build",
    "check": "biome check .",
    "format": "biome check --write .",
    "lerna": "lerna",
    "jest": "jest",
    "test:coverage": "rimraf ./coverage && jest --collectCoverage=true",
    "test": "npm run check && npm run check:tasks && npm run deps:dedupe && jest",
    "prepublishOnly": "npm run build",
    "postpublish": "node scripts/run-ci.js",
    "publish:canary": "lerna publish --canary",
    "release:version": "lerna version --no-git-tag-version --force-publish",
    "release:publish": "npm run build && npm test && lerna publish from-package",
    "publish:lts-2": "[[ $(git rev-parse --abbrev-ref HEAD) != lts-2 ]] && echo \"ERR: Publishing lts-2 can only be done on the lts-2 branch\" && exit 1 || npm run lerna publish -- --dist-tag lts-2",
    "outdated": "npm outdated || true && lerna exec --no-bail -- npm outdated",
    "deps:update": "npm-check-updates -i --workspaces --root",
    "deps:dedupe": "syncpack lint",
    "deps:dedupe:fix": "syncpack fix",
    "browserslist:update": "npx --yes update-browserslist-db@latest",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "check:circular": "madge --circular --extensions ts,tsx,jsx --exclude '\\.(s?css)$' packages/*/src",
    "typecheck": "lerna run typecheck --no-bail",
    "check:tasks": "node scripts/check-tasks.js",
    "check:tasks:remote": "node scripts/check-tasks.js --remote"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "biome check --write --no-errors-on-unmatched",
      "git add"
    ],
    "*.{md,scss,yaml,yml}": [
      "biome format --write --no-errors-on-unmatched",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint --edit $1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "16.2.3",
    "@commitlint/config-conventional": "16.2.1",
    "@swc/core": "1.15.40",
    "@swc/jest": "0.2.39",
    "@types/node": "24.19.2",
    "browserslist": "4.29.5",
    "buffer": "6.0.3",
    "classnames": "2.3.2",
    "conventional-changelog-cli": "2.2.2",
    "css-tree": "2.2.1",
    "detect-browser": "2.5.1",
    "express": "4.22.3",
    "fs-extra": "8.1.0",
    "history": "4.10.1",
    "html-to-react": "1.5.0",
    "husky": "1.3.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-environment-jsdom-global": "4.0.0",
    "jest-extended": "3.2.4",
    "js-string-escape": "1.0.1",
    "lerna": "10.0.1",
    "lint-staged": "9.4.3",
    "lodash": "4.18.1",
    "madge": "7.0.0",
    "npm-check-updates": "22.2.3",
    "object-fit-images": "3.2.4",
    "os-browserify": "0.3.0",
    "prop-types": "15.8.1",
    "quote": "0.4.0",
    "react": "19.1.0",
    "react-attr-converter": "0.3.1",
    "react-dom": "19.1.0",
    "react-player": "2.11.0",
    "resize-observer-polyfill": "1.5.1",
    "rimraf": "2.7.1",
    "sass": "1.100.0",
    "setimmediate": "1.0.5",
    "stream-browserify": "3.0.0",
    "syncpack": "15.3.2",
    "ts-jest": "29.4.15",
    "tsdown": "0.22.1",
    "typescript": "6.0.3",
    "url-search-params-polyfill": "4.0.1",
    "xml-js": "1.6.11"
  }
}
